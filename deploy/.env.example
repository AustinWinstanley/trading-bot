# Compose-level configuration for deploy/docker-compose.yml — separate from
# the app-level .env at the repo root (which holds broker/data-provider
# credentials and is mounted into the engine service via env_file, never
# read by compose itself). Copy this file to deploy/.env and fill it in.

# Image tags. Pin to a released version (e.g. v0.1.0) for anything you'd
# call production; `latest` tracks whatever the release workflow most
# recently pushed to GHCR.
ENGINE_TAG=latest
DASHBOARD_TAG=latest
MCP_TAG=latest
JOURNAL_TAG=latest

# Must match the host uid:gid that OWNS state/, reports/, and logs/ at the
# repo root — `id -u` / `id -g` of whichever account those directories
# currently belong to. A mismatch here means the engine (and journal)
# containers can't write to their own bind-mounted volumes; see
# docs/operations.md.
ENGINE_UID=1000
ENGINE_GID=1000
